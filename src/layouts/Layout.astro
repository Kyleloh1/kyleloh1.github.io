---
// src/layouts/Layout.astro
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import portrait from '../assets/profile.jpg';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  noindex = false,
  description = 'Kyle Loh — applied mathematics at Florida Atlantic University. Rigorous numerics for optimizers, conformal inference, and the mathematical foundations of machine learning.',
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://kyleloh1.github.io');

const sections = [
  { href: '/#about', label: 'About' },
  { href: '/#research', label: 'Research' },
  { href: '/#publications', label: 'Publications' },
  { href: '/#awards', label: 'Awards' },
];

const pages = [
  { href: '/blogs', label: 'Writing' },
  { href: '/teaching', label: 'Teaching' },
];

const social = [
  { href: 'https://github.com/Kyleloh1', icon: 'mdi:github', label: 'GitHub' },
  { href: 'https://scholar.google.com/citations?user=JsXe-TgAAAAJ&hl=en', icon: 'simple-icons:googlescholar', label: 'Google Scholar' },
  { href: 'https://www.youtube.com/channel/UC_G7YxEksu7C9z5A08fdv7g', icon: 'mdi:youtube', label: 'YouTube' },
  { href: 'https://www.linkedin.com/in/kyle-loh-a2a3272a9/', icon: 'mdi:linkedin', label: 'LinkedIn' },
  { href: 'mailto:kloh2023@fau.edu', icon: 'mdi:email-outline', label: 'Email' },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Kyle Loh" />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kyle Loh" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/apple-touch-icon.png', canonical)} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="shell">
      <aside class="rail">
        <div class="rail-head">
          <a href="/" aria-label="Home">
            <Image
              src={portrait}
              alt="Kyle Loh"
              class="portrait"
              width={208}
              densities={[1, 2]}
              loading="eager"
              fetchpriority="high"
            />
          </a>
          <div>
            <a class="wordmark" href="/">Kyle Loh</a>
            <p class="role">Applied Mathematics<br />Florida Atlantic University</p>
          </div>
        </div>

        <nav aria-label="Primary">
          <div class="nav-group">
            {sections.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
          <div class="nav-group">
            {pages.map((item) => (
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            ))}
            <a href="/cv.pdf" target="_blank" rel="noopener">Curriculum Vitae</a>
          </div>
        </nav>

        <div class="social">
          {social.map((item) => (
            <a
              href={item.href}
              aria-label={item.label}
              target={item.href.startsWith('mailto:') ? undefined : '_blank'}
              rel={item.href.startsWith('mailto:') ? undefined : 'noopener'}
            >
              <Icon name={item.icon} />
            </a>
          ))}
        </div>
      </aside>

      <main class="content" id="main">
        <slot />
      </main>
    </div>
  </body>
</html>
