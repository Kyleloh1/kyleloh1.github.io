---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  noindex = false,
  description = 'Kyle Loh, applied mathematics at Florida Atlantic University. Rigorous numerics for optimizers, conformal inference, and the mathematical foundations of machine learning.',
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://kyleloh1.github.io');

const sections = [
  { href: '/#about', label: 'About' },
  { href: '/#research', label: 'Research' },
  { href: '/#publications', label: 'Publications' },
];

const pages = [
  { href: '/blogs', label: 'Writing' },
  { href: '/teaching', label: 'Teaching' },
];

---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Kyle Loh" />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kyle Loh" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/apple-touch-icon.png', canonical)} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap"
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="/">Kyle Loh<span aria-hidden="true">.</span></a>
        <nav class="site-nav" aria-label="Primary">
          {sections.map((item) => <a href={item.href}>{item.label}</a>)}
          {pages.map((item) => (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
          <a class="cv-link" href="/cv.pdf" target="_blank" rel="noopener" aria-label="CV (PDF)">
            CV <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>

    <main class="content" id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <span>Kyle Loh <span class="footer-dot" aria-hidden="true">·</span> Florida Atlantic University</span>
      <a href="mailto:kloh2023@fau.edu">kloh2023@fau.edu</a>
    </footer>
  </body>
</html>
