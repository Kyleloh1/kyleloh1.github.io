---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import portrait from '../assets/profile.jpg';
import type { ImageMetadata } from 'astro';
import encoderDecoder from '../assets/encoder-decoder.png';
import torusDoubling from '../assets/rmsprop-torus-doubling-data-hero.png';
import heterogeneousNulls from '../assets/decentralized-heterogeneous-nulls.png';

interface Publication {
  title: string;
  alt?: string;
  authors: string;
  venue: string;
  link?: string;
  arxiv?: string;
  blog?: string;
  code?: string;
  figure?: ImageMetadata;
}

const publications: Publication[] = [
  {
    title: 'The Dynamics of RMSProp Beyond the Stability Threshold',
    authors: '<span class="me">Kyle Loh</span>, J.D. Mireles James, Zhenghao Xu, Molei Tao',
    venue: 'arXiv preprint, 2026',
    link: 'https://arxiv.org/abs/2610.30078',
    figure: torusDoubling,
    alt: 'Four numerical RMSProp trajectories showing smooth invariant curves and increasingly scattered point clouds.',
  },
  {
    title: 'Optimal Linear Baseline Models for Scientific Machine Learning',
    authors:
      'Alexander DeLise, <span class="me">Kyle Loh</span>, Krish Patel, Meredith Teague, Andrea Arnold, Matthias Chung',
    venue: 'Foundations of Data Science',
    link: 'https://www.aimsciences.org/article/doi/10.3934/fods.2026012',
    arxiv: 'https://arxiv.org/abs/2508.05831',
    blog: 'https://www.math.emory.edu/site/cmds-reuret/projects/2025-model-aware/',
    code: 'https://github.com/Kyleloh1/CMDS-REU-MADDI',
    figure: encoderDecoder,
    alt: 'Encoder-decoder schematic mapping an input y through a latent code z to an output x.',
  },
  {
    title: 'Decentralized Conformal Novelty Detection via Quantized Model Exchange',
    authors: '<span class="me">Kyle Loh</span>, Yu Xiang',
    venue: 'arXiv preprint',
    link: 'https://arxiv.org/abs/2605.08263',
    // code: 'https://github.com/Kyleloh1/Decentralized-Conformal-Novelty-Detection',  // repo offline pending revision
    figure: heterogeneousNulls,
    alt: `Four agents, each holding a different local null distribution, shown as four separate Gaussian
      point clouds with distinct spreads and orientations.`,
  },
];

const social = [
  { href: 'https://scholar.google.com/citations?user=JsXe-TgAAAAJ&hl=en', icon: 'simple-icons:googlescholar', label: 'Google Scholar' },
  { href: 'https://github.com/Kyleloh1', icon: 'mdi:github', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/kyle-loh-a2a3272a9/', icon: 'mdi:linkedin', label: 'LinkedIn' },
  { href: 'https://www.youtube.com/channel/UC_G7YxEksu7C9z5A08fdv7g', icon: 'mdi:youtube', label: 'YouTube' },
];

const awards = [
  { year: '2026', name: 'Barry M. Goldwater Scholarship' },
  { year: '2026', name: 'Phi Kappa Phi Scholarship' },
  { year: '2026', name: 'OURI Research Grant' },
  { year: '2024', name: 'Mu Alpha Theta Summer Grant' },
];

const about = `I am a fourth-year joint B.S.&ndash;M.S. student at Florida Atlantic University studying applied
  mathematics, where I work with
  <a href="https://www.math.fau.edu/people/faculty/mirelesjames.php" target="_blank" rel="noopener">Jason Mireles-James</a>
  and <a href="https://sites.google.com/site/yuxianghomepage/" target="_blank" rel="noopener">Yu Xiang</a>.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Kyle Loh',
  url: 'https://kyleloh1.github.io/',
  jobTitle: 'Joint B.S.–M.S. student in Applied Mathematics',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Florida Atlantic University' },
  knowsAbout: [
    'Applied mathematics',
    'Rigorous numerics',
    'Dynamical systems',
    'Conformal inference',
    'Machine learning theory',
  ],
  sameAs: [
    'https://github.com/Kyleloh1',
    'https://scholar.google.com/citations?user=JsXe-TgAAAAJ&hl=en',
    'https://www.linkedin.com/in/kyle-loh-a2a3272a9/',
  ],
};
---

<Layout title="Kyle Loh | Applied Mathematics">
  <section class="intro" id="about" aria-labelledby="intro-title">
    <div class="intro-copy">
      <p class="eyebrow">Applied Mathematics</p>
      <h1 id="intro-title">Kyle Loh</h1>
      <p set:html={about} />
      <p class="intro-research">
        My research focuses on the mathematical foundations of machine learning, and on using those
        foundations to build better algorithms.
      </p>
      <div class="intro-links" aria-label="Academic and social profiles">
        {social.map((item) => (
          <a href={item.href} target="_blank" rel="noopener">
            <Icon name={item.icon} aria-hidden="true" />{item.label}
          </a>
        ))}
      </div>
    </div>
    <div class="profile">
      <Image
        src={portrait}
        alt="Kyle Loh"
        class="portrait"
        width={416}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
      />
      <a class="profile-email" href="mailto:kloh2023@fau.edu">kloh2023@fau.edu</a>
    </div>
  </section>

  <section id="research" aria-labelledby="research-title">
    <div class="section-heading">
      <h2 id="research-title">Research</h2>
    </div>
    <article class="research-topic research-feature">
      <div>
        <h3>Rigorous numerics for optimizers</h3>
        <p>
          I use computer-assisted proofs to study quasiperiodic and chaotic structures, and routes to chaos,
          in adaptive optimizers such as RMSProp and Adam. My goal is to understand which mechanisms in an
          adaptive optimizer drive chaotic behavior.
        </p>
        <p>
          Our recent RMSProp paper proves that, for positive-definite quadratic losses, trajectories
          eventually enter a compact trapping region even when the learning rate makes the minimizer
          unstable. We derive explicit bounds on this region and use numerical continuation to study
          invariant circles, tori, and chaotic motion within it.
        </p>
        <div class="resource-links">
          <a href="https://arxiv.org/abs/2610.30078" target="_blank" rel="noopener">RMSProp paper <span aria-hidden="true">↗</span></a>
          <a href="https://kyleloh1.github.io/RMSProp/" target="_blank" rel="noopener">RMSProp visualizer <span aria-hidden="true">↗</span></a>
          <a href="https://kyleloh1.github.io/Adam/" target="_blank" rel="noopener">Adam visualizer <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <figure class="research-figure">
        <a href={torusDoubling.src} target="_blank" rel="noopener" aria-label="View RMSProp figure at full size">
          <Image
            src={torusDoubling}
            alt="A torus-doubling cascade in RMSProp, shown in four panels: smooth invariant curves break up into progressively more scattered point clouds as a parameter is varied."
            width={1200}
            loading="lazy"
          />
        </a>
        <figcaption>A torus-doubling cascade in RMSProp.</figcaption>
      </figure>
    </article>
    <article class="research-topic research-text">
      <h3>Conformal inference</h3>
      <p>
        I am developing conformal inference frameworks that bound the false discovery rate under practical
        constraints: decentralization, limited communication bandwidth, and non-exchangeability.
      </p>
    </article>
  </section>

  <section id="publications" aria-labelledby="publications-title">
    <div class="section-heading">
      <h2 id="publications-title">Publications</h2>
      <a href="https://scholar.google.com/citations?user=JsXe-TgAAAAJ&hl=en" target="_blank" rel="noopener">Google Scholar <span aria-hidden="true">↗</span></a>
    </div>
    {publications.map((p) => (
      <article class="entry">
        {p.figure && (
          <a class="entry-image" href={p.link} target="_blank" rel="noopener" aria-label={p.title}>
            <Image class="entry-figure" src={p.figure} alt={p.alt ?? ''} width={640} loading="lazy" />
          </a>
        )}
        <div class="entry-body">
          <h3>
            {p.link ? <a href={p.link} target="_blank" rel="noopener">{p.title}</a> : p.title}
          </h3>
          <p class="authors" set:html={p.authors} />
          <p class="venue">{p.venue}</p>
          <div class="resource-links">
            {p.link && <a href={p.link} target="_blank" rel="noopener">Paper</a>}
            {p.arxiv && <a href={p.arxiv} target="_blank" rel="noopener">arXiv</a>}
            {p.blog && <a href={p.blog} target="_blank" rel="noopener">Blog post</a>}
            {p.code && <a href={p.code} target="_blank" rel="noopener">Code</a>}
          </div>
        </div>
      </article>
    ))}
  </section>

  <section id="awards" aria-labelledby="awards-title">
    <div class="section-heading">
      <h2 id="awards-title">Awards</h2>
    </div>
    <ul class="ledger">
      {awards.map((a) => (
        <li>
          <span class="year">{a.year}</span>
          <span>{a.name}</span>
        </li>
      ))}
    </ul>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</Layout>
