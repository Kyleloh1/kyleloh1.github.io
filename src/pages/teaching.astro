---
// src/pages/teaching.astro
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Teaching | Kyle Loh"
  description="Kyle Loh's mathematics teaching: YouTube tutorials and openly available tutoring notes."
>
  <header class="masthead">
    <h1>Teaching</h1>
    <p class="standfirst">Lectures, tutorials, and notes I have written for students</p>
  </header>

  <section id="youtube">
    <div class="section-heading"><h2>YouTube</h2></div>
    <p class="lede">I run a channel of mathematics tutorials. Here is one to start with.</p>

    <div class="video">
      <iframe
        src="https://www.youtube-nocookie.com/embed/wPaA1QblObs"
        title="Kyle Loh's Math: featured tutorial"
        loading="lazy"
        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>

    <div class="resource-links">
      <a href="https://www.youtube.com/watch?v=wPaA1QblObs" target="_blank" rel="noopener">Watch on YouTube <span aria-hidden="true">↗</span></a>
      <a href="https://www.youtube.com/channel/UC_G7YxEksu7C9z5A08fdv7g" target="_blank" rel="noopener">All videos <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section id="notes">
    <div class="section-heading"><h2>Notes</h2></div>
    <article class="entry text-entry">
      <div class="entry-body">
        <h3>
          <a href="https://github.com/Kyleloh1/FAUHS-Biology-Notes" target="_blank" rel="noopener">
            FAUHS Biology Notes
          </a>
        </h3>
        <p>A complete set of ninth-grade biology notes I wrote and used while tutoring students.</p>
        <div class="meta">
          <span class="venue">Course notes</span>
          <a href="https://github.com/Kyleloh1/FAUHS-Biology-Notes" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
    </article>
  </section>
</Layout>
